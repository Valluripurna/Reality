{
  "name": "realitychain-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "server": "node server/index.js",
    "tunnel": "npx localtunnel --port 5000",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:server": "node --test server/server.test.js",
    "test:all": "npm run typecheck && npm test && npm run test:server",
    "brand": "node scripts/generate-brand-assets.js",
    "brand:preview": "node scripts/preview-brand.js"
  },
  "jest": {
    "preset": "jest-expo",
    "modulePaths": [
      "<rootDir>/node_modules/expo/node_modules"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/server/",
      "/.expo/",
      "/dist/"
    ],
    "setupFiles": [
      "./jest.setup.js"
    ]
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.1.2",
    "cors": "^2.8.6",
    "expo": "~57.0.30",
    "expo-application": "~57.0.3",
    "expo-constants": "~57.0.22",
    "expo-font": "~57.0.4",
    "expo-image-picker": "~57.0.1",
    "expo-linking": "~57.0.1",
    "expo-location": "~57.0.1",
    "expo-notifications": "~57.0.23",
    "expo-router": "~57.0.2",
    "expo-splash-screen": "~57.0.1",
    "expo-status-bar": "~57.0.0",
    "expo-updates": "~57.0.26",
    "express": "^5.2.1",
    "mongoose": "^9.9.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-qrcode-svg": "^6.3.26",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.4",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "typescript": "~6.0.3"
  }
}
