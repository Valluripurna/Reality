# RealityChain environment configuration. Copy to .env and fill in.

# --- App (bundled into the app; never put secrets in EXPO_PUBLIC_*) ---------
# API origin, e.g. https://api.example.com or a tunnel URL. Leave empty to run
# fully on-device (bookings are then shared only within one device/browser).
EXPO_PUBLIC_API_URL=
# Sign-in mode: "demo" (default; code 123456, no SMS) or "server" (OTP via the
# API below — requires EXPO_PUBLIC_API_URL and an SMS-capable server).
EXPO_PUBLIC_AUTH_MODE=demo

# --- Server only (server/index.js) -----------------------------------------
PORT=5000
# "development" logs OTP codes to the server console instead of sending SMS.
AUTH_MODE=development
# Optional. Without it, the server keeps data in memory.
MONGODB_URI=
# Optional AI provider key for the in-app assistant (server-side only).
GROK_API_KEY=
# Optional comma-separated list of allowed web origins.
CORS_ORIGINS=

# --- OTA / remote content (optional) ---------------------------------------
# EAS Update URL and project id. app.config.js reads these; normally
# `eas update:configure` writes them, or set them as CI secrets.
EXPO_UPDATES_URL=
EAS_PROJECT_ID=
# Server only: JSON string overriding /api/config (banners, schedules, copy).
REMOTE_CONFIG_JSON=
